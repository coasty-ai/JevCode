# the hand-off (TUI-DESIGN-3 §3.2, §3.3): a task hides the mark for the whole run (no wordmark frame between `[run] start` and `end`), at
# 24 rows the frame after `end` carries the strip AND the mark (F-W5); `/panel` opens the panel and the mark goes; `/panel off` brings it back
expect \x1b\[\?25l
expect Say hi
expect sess \$
sleep 0.3
send fix the failing test
sleep 0.2
send \r
expect \[run\](?:\x1b\[[0-9;]*m)* start 
expect end (complete|max_steps|generator_done)
expect Follow-up, question
sleep 0.4
mark ended
send /panel
sleep 0.2
send \r
expect ▾(?:\x1b\[[0-9;]*m)* decisions
sleep 0.3
mark panel-open
send /panel off
sleep 0.2
send \r
expect ▸(?:\x1b\[[0-9;]*m)* jev
sleep 0.3
mark panel-off
send /exit
sleep 0.2
send \r
eof
