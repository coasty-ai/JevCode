# the hand-off, as amended by the owner's directive of 2026-09-23: the settled mark is COMMITTED as the first scrollback block before the
# task, so no frame of the run or after `end` draws it in the dynamic region; the strip keeps the rule row after `end`; `/panel` opens the
# panel under the rule and `/panel off` gives the strip back, neither touching the mark
expect \x1b\[\?25l
expect Say hi
expect sess \$
sleep 0.3
send fix the failing test
sleep 0.2
send \r
expect step \d+/\d+
expect finished [·-] (complete|max_steps|generator_done)
expect Follow-up, question
sleep 0.4
mark ended
send /panel
sleep 0.2
send \r
expect ▾(?:\x1b\[[0-9;]*m)* decisions
sleep 0.3
mark panel-open
send /panel off
sleep 0.2
send \r
expect ▸(?:\x1b\[[0-9;]*m)* jev
sleep 0.3
mark panel-off
send /exit
sleep 0.2
send \r
eof
