# the hand-off, as amended by owner directive 2: the mark is PINNED, so a task keeps it up for the WHOLE run (a wordmark frame between
# `[run] start` and `end`, and after `end` the strip AND the mark); at 24 rows (< WORDMARK_SHARE_MIN_ROWS) `/panel` still takes the slot
# and `/panel off` gives it back
expect \x1b\[\?25l
expect Say hi
expect sess \$
sleep 0.3
send fix the failing test
sleep 0.2
send \r
expect step \d+/\d+
expect finished [·-] (complete|max_steps|generator_done)
expect Follow-up, question
sleep 0.4
mark ended
send /panel
sleep 0.2
send \r
expect ▾(?:\x1b\[[0-9;]*m)* decisions
sleep 0.3
mark panel-open
send /panel off
sleep 0.2
send \r
expect ▸(?:\x1b\[[0-9;]*m)* jev
sleep 0.3
mark panel-off
send /exit
sleep 0.2
send \r
eof
