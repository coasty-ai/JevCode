# the review at step 2 is declined with d <note> (§6.4); the card is a rounded `╭─ review · step 2` card in the boxed tier
# (TUI-DESIGN-2 §4.7, §8.2 review-d (ext.))
expect \x1b\[\?25l
expect Say hi
sleep 0.3
send make the tests pass
sleep 0.2
send \r
expect ╭─ (?:\x1b\[[0-9;]*m)*review · step 2
expect \[y\] approve
sleep 0.4
send d
expect note \(
send skip the tests
sleep 0.2
send \r
expect review declined (?:\x1b\[[0-9;]*m)*[·-] "skip the tests"
expect finished [·-] (complete|max_steps|generator_done)
expect Follow-up, question
send /exit
sleep 0.2
send \r
eof
