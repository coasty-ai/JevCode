# fish completion for jevcode — generated by scripts/gen-docs.mjs from src/cli/args.ts; do not edit by hand
# install: jevcode completion fish > ~/.config/fish/completions/jevcode.fish

function __jevcode_runs
  set -l runs (set -q JEVCODE_HOME; and echo $JEVCODE_HOME; or echo $HOME/.jevcode)/runs
  test -d $runs; and ls $runs
end

