#!/usr/bin/expect -f
# Generic pseudo-TTY driver for JevCode TUI tests and demos (macOS expect 5.45).
#
#   drive.exp [--kill-on-timeout] <steps-file> <capture-log> <timing-jsonl> <timeout-s> -- <command> [args...]
#
# Environment: PTY_ROWS / PTY_COLS set the initial geometry (default 24x80); PTY_TERM sets
# TERM for the child (default xterm-256color); PTY_KILL_ON_TIMEOUT=1 is the flag's twin; PTY_AUTO_REVIEW=<keys>
# answers every review box seen while an `expect` step waits (a one-second look, then the keys, then it waits for the
# engine's `confirm <id> approved|declined` line so a redrawn box is never answered twice).
#
# <steps-file>: one step per line (blank lines and lines starting with # are ignored):
#   expect <tcl-regex>      wait until the child's output matches (timeout -> exit 124)
#   send   <text>           write to the pty; backslash escapes are interpreted (\r \x03 \x1b)
#   sleep  <seconds>        pause (fractions allowed) while draining the pty in the background,
#                           so a chatty child never blocks in a synchronous tty write (research 20
#                           request (b)); the drained bytes still reach <capture-log>
#   resize <rows> <cols>    change the pty size; the kernel delivers SIGWINCH to the child
#   signal <NAME>           kill -<NAME> the child (INT, TERM, HUP, ...): an external signal, not a key
#   mark   <label>          record a timestamp only
#   eof                     wait for the child to exit
# Every completed step appends {"t":<ms since spawn>,"step":<n>,"op":"...","arg":"..."} to
# <timing-jsonl>; "expect" steps record the time of the match. The child's exit code is the
# driver's exit code (128+n when the child died from signal n); 124 = an expect step timed
# out (Ctrl-C is sent twice first, then a 10 s eof grace; with --kill-on-timeout a child still
# alive after the grace gets SIGKILL so the driver never wedges in `wait`). Note: the TUI's
# header row also contains "step 0/", so a step that must wait for the dynamic frame should
# expect the cursor-hide sequence \x1b\[\?25l or the status row pattern "step 0/.*starting"
# preceded by a newline.
set killOnTimeout 0
if {[info exists env(PTY_KILL_ON_TIMEOUT)] && $env(PTY_KILL_ON_TIMEOUT) ne "" && $env(PTY_KILL_ON_TIMEOUT) ne "0"} { set killOnTimeout 1 }
if {[lindex $argv 0] eq "--kill-on-timeout"} {
  set killOnTimeout 1
  set argv [lrange $argv 1 end]
}
# PTY_AUTO_REVIEW=<keys>: answer every review box seen during an `expect` step with these keys (e.g. y, or "d fine\r")
set autoReview ""
if {[info exists env(PTY_AUTO_REVIEW)] && $env(PTY_AUTO_REVIEW) ne ""} { set autoReview [subst -nocommands -novariables $env(PTY_AUTO_REVIEW)] }
set stepsFile [lindex $argv 0]
set capture [lindex $argv 1]
set timing [lindex $argv 2]
set timeout_s [lindex $argv 3]
set cmd [lrange $argv 5 end]

set rows 24
set cols 80
if {[info exists env(PTY_ROWS)]} { set rows $env(PTY_ROWS) }
if {[info exists env(PTY_COLS)]} { set cols $env(PTY_COLS) }
if {![info exists env(PTY_TERM)]} { set env(TERM) "xterm-256color" } else { set env(TERM) $env(PTY_TERM) }

log_user 0
log_file -a $capture
set timeout $timeout_s
set stty_init "rows $rows cols $cols"
match_max 65536   ;# a small window keeps expect's per-chunk regex scan cheap: a 1 MB window made the reader lag behind a chatty TUI (docs/live/tui attempt 2)

set fh [open $stepsFile r]
set steps [split [read $fh] "\n"]
close $fh

set t0 [clock milliseconds]
spawn -noecho {*}$cmd
set slave $spawn_out(slave,name)
set tf [open $timing a]

proc jsonEscape {s} {
  set s [string map {\\ \\\\ \" \\\" \n \\n \r \\r \t \\t} $s]
  return $s
}
proc record {tf t0 n op arg} {
  set t [expr {[clock milliseconds] - $t0}]
  puts $tf "{\"t\":$t,\"step\":$n,\"op\":\"$op\",\"arg\":\"[jsonEscape $arg]\"}"
  flush $tf
}
# a timed pause that keeps reading the pty (25 ms granularity); returns "eof" when the child exited meanwhile
proc drainSleep {secs} {
  set deadline [expr {[clock milliseconds] + int($secs * 1000)}]
  while {1} {
    set left [expr {$deadline - [clock milliseconds]}]
    if {$left <= 0} { return ok }
    expect -timeout 0 -re {.+} {} eof { return eof }
    after [expr {$left < 25 ? $left : 25}]
  }
}
proc childAlive {} {
  return [expr {[catch {exec kill -0 [exp_pid]}] == 0}]
}

set n 0
set code 0
set timedOut 0
foreach raw $steps {
  set line [string trim $raw]
  if {$line eq "" || [string index $line 0] eq "#"} { continue }
  incr n
  set op [lindex [split $line] 0]
  set arg [string trim [string range $line [string length $op] end]]
  switch -- $op {
    expect {
      if {$autoReview ne ""} {
        # PTY_AUTO_REVIEW: while waiting, answer every review box (its keys line) after a one-second look, then wait for the
        # engine's `confirm <id> approved|declined` line before continuing so redrawn frames of the same box are not answered twice
        expect {
          -re {\[y\] approve +\[n\] decline} {
            record $tf $t0 $n auto-review-seen ""
            # drain while looking: a plain `sleep` stops reading the pty, and Node's synchronous TTY writes then block
            # the child's whole event loop on the next frame until we read again — its React passive effects (the
            # review arming) are starved, and a `y` sent afterwards is processed first (docs/live/tui attempts 1–3)
            drainSleep 1
            send -- $autoReview
            expect -timeout 20 -re {confirm [^ ]+ (approved|declined)} { record $tf $t0 $n auto-review-resolved $expect_out(1,string) } timeout { record $tf $t0 $n auto-review-unresolved "" }
            exp_continue
          }
          -re $arg { record $tf $t0 $n expect $arg }
          timeout {
            record $tf $t0 $n timeout $arg
            set timedOut 1
            send -- "\003"
            sleep 0.5
            send -- "\003"
            break
          }
          eof { record $tf $t0 $n eof-before-match $arg; break }
        }
      } else {
        expect {
          -re $arg { record $tf $t0 $n expect $arg }
          timeout {
            record $tf $t0 $n timeout $arg
            set timedOut 1
            send -- "\003"
            sleep 0.5
            send -- "\003"
            break
          }
          eof { record $tf $t0 $n eof-before-match $arg; break }
        }
      }
    }
    send {
      set text [subst -nocommands -novariables $arg]
      send -- $text
      record $tf $t0 $n send $arg
    }
    sleep {
      set r [drainSleep $arg]
      record $tf $t0 $n sleep $arg
      if {$r eq "eof"} { record $tf $t0 $n eof-during-sleep $arg; break }
    }
    signal {
      catch {exec kill -$arg [exp_pid]}
      record $tf $t0 $n signal $arg
    }
    resize {
      set r [lindex $arg 0]
      set c [lindex $arg 1]
      stty rows $r cols $c < $slave
      record $tf $t0 $n resize $arg
    }
    mark {
      record $tf $t0 $n mark $arg
    }
    eof {
      expect {
        eof { record $tf $t0 $n eof "" }
        timeout { record $tf $t0 $n timeout "eof"; set timedOut 1; send -- "\003"; sleep 0.5; send -- "\003" }
      }
    }
    default {
      puts stderr "drive.exp: unknown step '$op' on line: $line"
      exit 2
    }
  }
}
if {$timedOut} {
  # the two Ctrl-Cs may not end the child (a non-empty draft is cleared instead); after the grace, --kill-on-timeout
  # sends SIGKILL to a child that is still running (kill -0 also succeeds on a zombie, so the eof seen above decides)
  set sawEof 0
  expect -timeout 10 eof { set sawEof 1 }
  if {$killOnTimeout && !$sawEof && [childAlive]} {
    catch {exec kill -9 [exp_pid]}
    record $tf $t0 0 kill-on-timeout SIGKILL
    catch {expect -timeout 5 eof}
  }
}
catch wait result
# wait returns {pid spawn_id 0 status} on a normal exit, {pid spawn_id -1 errno} on an OS error
# and {pid spawn_id 0 0 CHILDKILLED SIGNAME description} when the child died from a signal; in
# that last case the status element is 0, so the signal is mapped to the shell convention 128+n.
set code [lindex $result 3]
if {[lindex $result 2] == -1} {
  set code 1
  record $tf $t0 0 wait-error [lindex $result 3]
} elseif {[llength $result] > 4 && [lindex $result 4] eq "CHILDKILLED"} {
  set signame [lindex $result 5]
  array set signum {SIGHUP 1 SIGINT 2 SIGQUIT 3 SIGABRT 6 SIGKILL 9 SIGSEGV 11 SIGPIPE 13 SIGALRM 14 SIGTERM 15}
  set code [expr {[info exists signum($signame)] ? 128 + $signum($signame) : 128}]
  record $tf $t0 0 signal $signame
}
record $tf $t0 0 exit $code
close $tf
if {$timedOut} { exit 124 }
exit $code
