# Live TUI session (real Jev + generator): chat mode on /tmp/jevcode-demo.
# 1. first frame, task submitted from the composer
expect \x1b\[\?25l
mark first-frame
sleep 0.5
send Fix the failing tests in tests/test_core.py without changing the tests.\r
expect \[run\] ready
mark run-started
# 2. steer while live (queued for the next step)
sleep 2
send Prefer the smallest change and run the tests after every edit.\r
expect steer queued
mark steered
# 3. answer reviews with y until the run ends (the driver loop below handles repeats)
expect end (complete|max_steps|spend_cap|wall_time|human_pause|replan_stop|impossible|error)
mark run-ended
# 4. follow-up run seeded from the first
sleep 1
send Add a one-line docstring to every function in calc/core.py, then run the tests.\r
expect \[run\] ready
mark followup-started
# 5. pause at the next step boundary, then inspect
sleep 6
send \x1b
expect end human_pause
mark paused
sleep 1
send /cost\r
expect \[ui\] run
send /plan\r
expect \[ui\] plan
send /diff\r
expect diff \(run
send /decisions\r
expect \[ui\] decisions
mark inspected
# 6. continue the paused run (/continue = the most recently used run here; bare /resume opens the picker) and let it finish
send /continue\r
expect \[run\] ready
mark resumed-started
expect (end (complete|max_steps|spend_cap|wall_time|human_pause|replan_stop|impossible|error)|\[ui\] error)
mark resumed-ended
sleep 1
send /exit\r
eof
