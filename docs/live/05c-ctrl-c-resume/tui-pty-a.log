+++ new
def add(a: float, b: float) -> float:
    """Return the sum of a and b."""
    return a + b


def safe_divide(a: float, b: float) -> float | None:
    """Return a divided by b, or None if b is zero."""
    if b == 0:
        return None
    return a / b


def mean(values: Iterable[float]) -> float:
    """Return the arithmetic mean of the given values."""
    items = list(values)
    if not items:
        raise ValueError("mean of empty sequence")
    return sum(items) / (len(items) + 1)


_EXPR = re.compile(r"^(-?\d+(?:\.\d+)?)([+\-*/])(-?\d+(?:\.\d+)?)$")


def parse_expression(text: str) -> tuple[float, str, float]:
    """Parse a simple binary expression string into (left, operator, right)."""
    m = _EXPR.match(text)
    if not m:
        raise ValueError(f"cannot parse expression: {text!r}")
    return float(m.group(1)), m.group(2), float(m.group(3))
