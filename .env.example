# One OpenRouter key runs both Jev (openrouter.ai/api/alpha/decisions) and the default code model z-ai/glm-5.3-flash.
OPENROUTER_API_KEY=sk-or-v1-...  # one key: Jev + the code model
# Jev native (api.typesafe.ai) — preferred for Jev whenever it is set; add OPENROUTER_API_KEY for the code model.
TYPESAFE_API_KEY=
# Optional: Anthropic as the code model instead (JEVCODE_PROVIDER=anthropic pairs with ANTHROPIC_API_KEY).
# JEVCODE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Decider (Jev). Defaults shown; JEV_API_KEY falls back to OPENROUTER_API_KEY.
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13-20260917
# Budgets (the run cap defaults to $2.00 in jev+llm, $0.25 in jev-only; the session cap is 5×)
JEVCODE_SPEND_CAP_USD=2
JEVCODE_MAX_STEPS=40
JEVCODE_MAX_WALL=30m
# TUI-DESIGN-4 §1.3.1: the opt-in full-screen renderer (header pinned at row 1, a scrollable viewport instead of
# the terminal's own scrollback). `--fullscreen` / `--renderer <classic|fullscreen>` and the `ui.renderer` config
# row set the same thing; the launch order is flag > env > config file > classic.
# JEVCODE_RENDERER=fullscreen

# Other generator providers (src/provider/**; the picker lists a provider once its key is present). Never commit real keys.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...          # GOOGLE_API_KEY is accepted as a fallback
# FIREWORKS_API_KEY=...
# META_API_KEY=...            # MODEL_API_KEY is accepted as a fallback
# XAI_API_KEY=...
