{
  "name": "jevcode",
  "version": "0.1.0",
  "description": "Coding-agent harness where Jev (typesafe/jev-1.13) makes every decision and Claude writes the code. One Ink TUI, sandboxed subprocesses, checkpoints, bench.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": { "jevcode": "bin/jevcode.js" },
  "files": ["bin", "dist", "README.md", "docs"],
  "engines": { "node": ">=22.12.0 <27" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && node scripts/no-any.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:live": "JEVCODE_LIVE=1 vitest run --project live",
    "perf": "npm run build && node bin/jevcode.js perf",
    "bench": "node bin/jevcode.js bench",
    "dev": "tsx src/cli/main.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
