/**
 * lit-repair follow-up (live, cents): can Jev rank the developer fix among ALL depth-1 operator
 * candidates for the buggy line (30..935 candidates, generated by quixbugs_operator_coverage.py)?
 * Stage 1: one Noul per candidate (batches of 300, criteria once in state). Stage 2: Choice over the
 * Noul top-100 (or all candidates when <= 254). Reports rank, MRR, cost, latency.
 * Usage: env -u ANTHROPIC_API_KEY node --env-file=.env node_modules/.bin/tsx experiments/lit-repair/jev-rank-probe.mts
 */
import { readFileSync, existsSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { createJevDecider } from '../../src/jev/client.ts';
import { choice, contextNoul } from '../../src/jev/questions.ts';
import type { Json } from '../../src/core/types.ts';

const ROOT = '/tmp/quixbugs';
const HERE = new URL('.', import.meta.url).pathname;
const key = process.env['OPENROUTER_API_KEY'] ?? '';
if (!key) throw new Error('OPENROUTER_API_KEY missing');
const jev = createJevDecider({ baseUrl: 'https://openrouter.ai/api/alpha/decisions', apiKey: key, model: 'typesafe/jev-1.13-20260917', pinned: true }, { redact: (s) => s });
const signal = new AbortController().signal;
const CAP_USD = 0.4;
let cost = 0; const lat: number[] = [];

function codeOnly(src: string): string[] {
  const i = src.indexOf('\n"""');
  return (i > 0 ? src.slice(0, i) : src).replace(/\s+$/, '').split('\n');
}
function seeded(seed: number) { let s = seed >>> 0; return () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 2 ** 32; }; }
function norm(s: string) { return s.trim().replace(/\s+/g, ' '); }

interface Row { program: string; kind: string; covered_by: string | null; added: string[]; cands: { buggy_line_candidates: { line?: number; original?: string; candidates?: Record<string, string> } } }
const report = JSON.parse(readFileSync(join(HERE, 'quixbugs-operator-coverage.json'), 'utf8')) as { rows: Row[] };
const rows = report.rows.filter((r) => r.kind === 'replace_1' && r.covered_by && r.cands.buggy_line_candidates.candidates);
// Verification hooks (2026-09-20 checker): PROGRAMS=a,b,c restricts the run; OUT=<file> redirects the output (default jev-rank-results.json).
const ONLY = (process.env['PROGRAMS'] ?? '').split(',').map((s) => s.trim()).filter(Boolean);
const ROWS = ONLY.length ? rows.filter((r) => ONLY.includes(r.program)) : rows;
const OUT = process.env['OUT'] ?? 'jev-rank-results.json';

const CRITERIA = {
  what_correct_means: 'A candidate is the correct fix only if replacing `buggy_line` with exactly that text makes the function compute the expected output for every test (and for inputs like them), with no other change.',
  not_correct: ['a change that makes only some tests pass', 'a change that is syntactically plausible but leaves the algorithm wrong', 'the original line unchanged', 'a change to a part of the line that is not the defect'],
  correct_examples: ['off-by-one fixed so a loop covers the last element the test expects', 'swapped arguments restored to the order the algorithm requires'],
};

async function one(r: Row, rng: () => number) {
  const p = r.program;
  const buggy = codeOnly(readFileSync(join(ROOT, 'python_programs', `${p}.py`), 'utf8'));
  const nonEmpty = buggy.map((l, i) => [l, i] as const).filter(([l]) => l.trim() !== '');
  const blc = r.cands.buggy_line_candidates;
  const truth = norm(r.added[0]!);
  let list = Object.keys(blc.candidates!).filter((c) => c !== '' && norm(c) !== norm(blc.original!));
  if (!list.some((c) => norm(c) === truth)) list.push(truth);
  list = list.map((c) => [c, rng()] as const).sort((a, b) => a[1] - b[1]).map(([c]) => c);
  const keyOf = (i: number) => `cand_${String(i + 1).padStart(3, '0')}`;
  const candObj: Record<string, Json> = Object.fromEntries(list.map((c, i) => [keyOf(i), c]));
  const truthKey = keyOf(list.findIndex((c) => norm(c) === truth));
  let tests: Json = [];
  const tj = join(ROOT, 'json_testcases', `${p}.json`);
  if (existsSync(tj)) tests = (JSON.parse(`[${readFileSync(tj, 'utf8').trim().split('\n').join(',')}]`) as Json[][]).slice(0, 4).map((t) => ({ input: t[0]!, expected: t[1]! }));
  else tests = readFileSync(join(ROOT, 'python_testcases', `test_${p}.py`), 'utf8').slice(0, 2500);
  const state: Json = {
    task: `The Python function \`${p}\` has a single-line bug on the line \`buggy_line\` (line L${blc.line}). Exactly one entry of \`candidates\` is the developer's fix.`,
    program: Object.fromEntries(nonEmpty.map(([l, i]) => [`L${i + 1}`, l])),
    tests, buggy_line: blc.original!, candidates: candObj, criteria: CRITERIA,
  };
  // stage 1: Nouls in batches of 300
  const probs: Record<string, number> = {};
  const keys = Object.keys(candObj);
  for (let i = 0; i < keys.length; i += 300) {
    const batch = keys.slice(i, i + 300);
    const qs = Object.fromEntries(batch.map((k) => [`is_fix_${k}`, contextNoul(`Is \`candidates.${k}\` the correct replacement for \`buggy_line\` according to \`criteria\`, so that all \`tests\` pass? Answer carefully and literally.`)]));
    const res = await jev.ask(state, qs, { signal, stage: 'context', step: 1 });
    cost += res.usage.costUsd; lat.push(res.latencyMs);
    for (const k of batch) { const a = res.answers[`is_fix_${k}`]; probs[k] = a && a.type === 'noul' ? a.noul : 0; }
  }
  const ranked = keys.slice().sort((a, b) => probs[b]! - probs[a]!);
  const pt = probs[truthKey]!;
  const higher = ranked.filter((k) => probs[k]! > pt).length, ties = ranked.filter((k) => probs[k] === pt).length;
  const noulRank = higher + (ties + 1) / 2;
  // stage 2: Choice over top-100 (or all if <= 254)
  const shortlist = keys.length <= 254 ? keys : ranked.slice(0, 100);
  if (!shortlist.includes(truthKey)) shortlist.push(truthKey); // record separately whether the shortlist cut it
  const cutByNoul = keys.length > 254 && !ranked.slice(0, 100).includes(truthKey);
  const opts: Record<string, Json | null> = Object.fromEntries(shortlist.map((k) => [k, null]));
  const res2 = await jev.ask(state, { fix: choice('Which entry of `candidates` is the correct replacement for `buggy_line` according to `criteria`, so that all `tests` pass? Pick `none_of_these` if no entry is a correct fix.', opts) }, { signal, stage: 'risk', step: 1 });
  cost += res2.usage.costUsd; lat.push(res2.latencyMs);
  const a2 = res2.answers['fix']!;
  let choiceRank = NaN, pTop = NaN, pTruth = NaN, chosen = '';
  if (a2.type === 'choice') {
    const cr = Object.entries(a2.probabilities).sort((x, y) => y[1] - x[1]);
    choiceRank = cr.findIndex(([k]) => k === truthKey) + 1; pTop = cr[0]![1]; pTruth = a2.probabilities[truthKey] ?? 0; chosen = cr[0]![0];
  }
  const row = { program: p, operator: r.covered_by, n_candidates: keys.length, truth, noul_p_truth: +pt.toFixed(3), noul_rank: noulRank, noul_top1: noulRank <= 1, noul_top5: noulRank <= 5, noul_top10: noulRank <= 10,
    noul_max_p: +Math.max(...Object.values(probs)).toFixed(3), shortlist: shortlist.length, cut_by_noul_top100: cutByNoul, choice_rank: choiceRank, choice_top1: choiceRank === 1, choice_p_truth: +pTruth.toFixed(3), choice_p_top: +pTop.toFixed(3), chosen_text: chosen ? String(candObj[chosen] ?? chosen) : '' };
  console.log(`${p.padEnd(27)} n=${String(keys.length).padStart(4)} noul: p=${row.noul_p_truth.toFixed(2)} rank=${noulRank} (max ${row.noul_max_p}) | choice(${shortlist.length}): rank=${choiceRank} p_true=${row.choice_p_truth} top=${row.choice_p_top} ${choiceRank === 1 ? 'Y' : 'n'}`);
  return row;
}

const out: Awaited<ReturnType<typeof one>>[] = [];
const rng = seeded(20260920);
for (let i = 0; i < ROWS.length; i += 6) {
  if (cost > CAP_USD) { console.log('cost cap reached'); break; }
  const chunk = ROWS.slice(i, i + 6);
  const rs = await Promise.all(chunk.map((r) => one(r, seeded(20260920 + rows.indexOf(r))))); // seed by position in the full list so PROGRAMS= reruns reproduce the original shuffle
  out.push(...rs);
}
void rng;
lat.sort((a, b) => a - b);
const mrr = (xs: number[]) => xs.reduce((s, r) => s + (r > 0 ? 1 / r : 0), 0) / xs.length;
const summary = { n: out.length, noul_top1: out.filter((r) => r.noul_top1).length, noul_top5: out.filter((r) => r.noul_top5).length, noul_top10: out.filter((r) => r.noul_top10).length, noul_mrr: +mrr(out.map((r) => r.noul_rank)).toFixed(3),
  choice_top1: out.filter((r) => r.choice_top1).length, choice_top5: out.filter((r) => r.choice_rank >= 1 && r.choice_rank <= 5).length, choice_mrr: +mrr(out.map((r) => r.choice_rank)).toFixed(3), cut_by_noul_top100: out.filter((r) => r.cut_by_noul_top100).length,
  mean_candidates: Math.round(out.reduce((s, r) => s + r.n_candidates, 0) / out.length), requests: lat.length, cost_usd: +cost.toFixed(4), latency_p50_ms: lat[Math.floor(lat.length / 2)], latency_p95_ms: lat[Math.floor(lat.length * 0.95)] };
console.log(JSON.stringify(summary));
writeFileSync(join(HERE, OUT), JSON.stringify({ summary, rows: out }, null, 1));
